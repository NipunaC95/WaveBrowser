{
  "name": "wavebrowse",
  "version": "1.0.0",
  "description": "Lightning-fast audio sample previewer with waveforms and native drag-and-drop to any DAW or software",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx build.ts",
    "start": "tsx build.ts && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "tsx build.ts && env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "keywords": [
    "audio",
    "sample-manager",
    "daw",
    "music",
    "waveform",
    "drag-and-drop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^12.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "33.4.11",
    "esbuild": "0.28.2",
    "rimraf": "6.1.4",
    "sass": "^1.108.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
