{
  "name": "wavebrowse",
  "version": "1.0.0",
  "description": "Pro-grade desktop audio asset manager & sample library browser with GPU-accelerated WebGL waveforms and native drag-and-drop to any DAW, NLE, or game engine",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx build.ts",
    "pack": "tsx build.ts && electron-builder --dir",
    "dist": "tsx build.ts && electron-builder -mw",
    "dist:mac": "tsx build.ts && electron-builder --mac",
    "dist:win": "tsx build.ts && electron-builder --win",
    "dist:all": "tsx build.ts && electron-builder -mw",
    "dist:linux": "tsx build.ts && electron-builder --linux",
    "start": "tsx build.ts && node scripts/launch.mjs",
    "dev": "tsx build.ts && node scripts/launch.mjs"
  },
  "keywords": [
    "audio",
    "sample-manager",
    "daw",
    "music",
    "waveform",
    "drag-and-drop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^12.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "rimraf": "6.1.4",
    "sass": "^1.108.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
